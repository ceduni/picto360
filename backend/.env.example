# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=
FRONTEND_SERVER=

# ─── Session ──────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -hex 32
FASTIFY_SESSION_SECRET=

# ─── Google OAuth (Drive export) ──────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-random-secret
JWT_REFRESH_SECRET=replace-with-another-random-secret

# ─── CloudFlare ────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN =
CLOUDFLARE_ACCOUNT_ID =
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
R2_MEDIA_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# ─── OneDrive OAuth (optional) ────────────────────────────────────────────────
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REDIRECT_URI=BACKEND_URI/api/onedrive/auth/callback


